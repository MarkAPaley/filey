; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppExeName "filey.exe"
#define MyAppName "filey"

; ----------------------------------------------------------------------------
; Where the files come from. No absolute paths, so this script works from
; any checkout, from the Inno Setup IDE, and from filey-bundleme.sh, which
; runs the command-line compiler (ISCC.exe) through Wine and passes:
;   /DFileySrc=<the src folder>         (no trailing backslash)
;   /DFileyExe=<the filey.exe to package>
; Without them, the src folder is found from where this script is: either
; this folder itself, or a "src" folder inside it.
; ----------------------------------------------------------------------------
#ifndef FileySrc
  #if FileExists(AddBackslash(SourcePath) + "bin\x86_64-win64\" + MyAppExeName)
    #define FileySrc RemoveBackslash(SourcePath)
  #elif FileExists(AddBackslash(SourcePath) + "src\bin\x86_64-win64\" + MyAppExeName)
    #define FileySrc AddBackslash(SourcePath) + "src"
  #else
    #error filey.exe not found in bin\x86_64-win64 next to this script or in its src folder - build the Win64 mode first, or pass /DFileySrc=
  #endif
#endif
#define SrcDir AddBackslash(FileySrc)
#ifndef FileyExe
  #define FileyExe SrcDir + "bin\x86_64-win64\" + MyAppExeName
#endif

#define MyAppVersion GetVersionNumbersString(FileyExe)
; "filey-3.1.0.800", matching the AppImage and zip names
; (filey-3.1.0.800-x86_64.AppImage, filey-3.1.0.800-win64.zip).
#define MyAppVerName MyAppName + "-" + MyAppVersion
#define MyAppPublisher "Mark A Paley Software"
#define MyAppURL "https://gitlab.com/MarkAPaley/filey"

; ----------------------------------------------------------------------------
; Files/folders that the app creates at runtime and that should be cleaned up
; on uninstall. CnfgDir is the directory that will be removed afterward,
; but ONLY if it ends up empty once the listed files/patterns are gone.
; ----------------------------------------------------------------------------
#define CnfgDir "{localappdata}\filey"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{B011ABF0-0884-4E62-8CFE-615EA685A8B3}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} version {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
; Uncomment the following line to use a 64-bit installer.
;SetupArchitecture=x64
DisableProgramGroupPage=yes
LicenseFile={#SrcDir}license.txt
; Remove the following line to run in administrative install mode (install for all users).
PrivilegesRequired=lowest
; filey-bundleme.sh overrides this with ISCC's /O switch.
OutputDir={#SrcDir}releases
OutputBaseFilename={#MyAppVerName}-setup-win64
SetupIconFile={#SrcDir}filey.ico
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "{#FileyExe}"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]

// -----------------------------------------------------------------------
// List the specific files (full paths, after ExpandConstant) that should
// be removed on uninstall. Add/remove entries as needed - the directory
// they live in (CnfgDir, defined above) is removed afterward only if it
// turns out to be empty.
// -----------------------------------------------------------------------
function GetCnfgFilesToDelete(): TArrayOfString;
begin
  SetArrayLength(Result, 16);
  Result[0]  := ExpandConstant('{#CnfgDir}\allshows.txt');
  Result[1]  := ExpandConstant('{#CnfgDir}\debug.log');
  Result[2]  := ExpandConstant('{#CnfgDir}\error.log');
  Result[3]  := ExpandConstant('{#CnfgDir}\extracted-files.txt');
  Result[4]  := ExpandConstant('{#CnfgDir}\ffprobe.exe');
  Result[5]  := ExpandConstant('{#CnfgDir}\filey.ini');
  Result[6]  := ExpandConstant('{#CnfgDir}\filey64.png');
  Result[7]  := ExpandConstant('{#CnfgDir}\filey-src.zip');
  Result[8]  := ExpandConstant('{#CnfgDir}\libeay32.dll');
  Result[9]  := ExpandConstant('{#CnfgDir}\license.txt');
  Result[10] := ExpandConstant('{#CnfgDir}\mkvmerge.exe');
  Result[11] := ExpandConstant('{#CnfgDir}\mkvpropedit.exe');
  Result[12] := ExpandConstant('{#CnfgDir}\Privacy_Policy.html');
  Result[13] := ExpandConstant('{#CnfgDir}\README.html');
  Result[14] := ExpandConstant('{#CnfgDir}\README2.html');
  Result[15] := ExpandConstant('{#CnfgDir}\ssleay32.dll');
end;

// Wildcard patterns (matched against files directly inside CnfgDir only -
// no recursion into subfolders) to remove on uninstall, e.g. '*.DBF'.
function GetCnfgPatternsToDelete(): TArrayOfString;
begin
  SetArrayLength(Result, 2);
  Result[0] := '*.DBF';
  Result[1] := '*.MDX';
end;

// True for a bare name of the exact shape "_" followed by one or more
// digits (e.g. "_1", "_10", "_237") and nothing else. Windows' native
// wildcard matching (what FindFirst's Pattern argument uses) only supports
// '*'/'?', so '_*' would also catch a hypothetical "_backup.tmp" or
// similar; this predicate is checked per-file instead, to delete only
// names that are exactly underscore + digits.
function IsUnderscoreDigitsName(const AName: string): Boolean;
var
  I: Integer;
begin
  Result := False;
  if (Length(AName) < 2) or (AName[1] <> '_') then Exit;
  for I := 2 to Length(AName) do
    if not ((AName[I] >= '0') and (AName[I] <= '9')) then Exit;
  Result := True;
end;

// Deletes every file directly inside DirPath whose bare name is exactly
// "_" followed by digits (see IsUnderscoreDigitsName). Does not recurse
// into subdirectories. Catches the numbered "_1", "_2", "_3"... files
// Filey wrote directly into its own install folder at runtime before
// 3.1.0.800 (TDbf's pack scratch copies of its in-memory tables), which the
// standard [Files]-driven uninstall never touches because it only removes
// what it explicitly installed.
procedure DeleteUnderscoreDigitsFiles(const DirPath: string);
var
  FindRec: TFindRec;
  Found: Boolean;
begin
  if FindFirst(DirPath + '\*', FindRec) then
  begin
    try
      Found := True;
      while Found do
      begin
        if (FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY = 0) and
           IsUnderscoreDigitsName(FindRec.Name) then
          DeleteFile(DirPath + '\' + FindRec.Name);
        Found := FindNext(FindRec);
      end;
    finally
      FindClose(FindRec);
    end;
  end;
end;

// True for a bare name of exactly 8 uppercase hex digits ("8DE146F7").
// Before 3.1.0.800 filey saved each extracted-files.txt entry as a file of
// that name in its current folder - {app}, when started from the Start
// menu or desktop shortcut (their "Start in" folder). filey 3.1.0.800 and
// later delete them on startup after checking their contents; this catches
// any still there when filey is uninstalled without being run again.
function IsHexName8(const AName: string): Boolean;
var
  I: Integer;
begin
  Result := False;
  if Length(AName) <> 8 then Exit;
  for I := 1 to 8 do
    if not (((AName[I] >= '0') and (AName[I] <= '9')) or
            ((AName[I] >= 'A') and (AName[I] <= 'F'))) then Exit;
  Result := True;
end;

// Deletes every file directly inside DirPath named by IsHexName8. Only ever
// called for {app}, filey's own folder.
procedure DeleteHexNameFiles(const DirPath: string);
var
  FindRec: TFindRec;
  Found: Boolean;
begin
  if FindFirst(DirPath + '\*', FindRec) then
  begin
    try
      Found := True;
      while Found do
      begin
        if (FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY = 0) and
           IsHexName8(FindRec.Name) then
          DeleteFile(DirPath + '\' + FindRec.Name);
        Found := FindNext(FindRec);
      end;
    finally
      FindClose(FindRec);
    end;
  end;
end;

// Deletes every file directly inside DirPath matching Pattern (e.g. '*.DBF').
// Does not recurse into subdirectories.
procedure DeleteFilesByPattern(const DirPath, Pattern: string);
var
  FindRec: TFindRec;
  Found: Boolean;
  FullPath: string;
begin
  if FindFirst(DirPath + '\' + Pattern, FindRec) then
  begin
    try
      Found := True;
      while Found do
      begin
        if (FindRec.Name <> '.') and (FindRec.Name <> '..') and
           (FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY = 0) then
        begin
          FullPath := DirPath + '\' + FindRec.Name;
          DeleteFile(FullPath);
        end;
        Found := FindNext(FindRec);
      end;
    finally
      FindClose(FindRec);
    end;
  end;
end;

// Returns True if DirPath contains no files and no subdirectories.
function IsDirEmpty(const DirPath: string): Boolean;
var
  FindRec: TFindRec;
  Found: Boolean;
begin
  Result := True;
  if FindFirst(DirPath + '\*', FindRec) then
  begin
    try
      Found := True;
      while Found do
      begin
        if (FindRec.Name <> '.') and (FindRec.Name <> '..') then
        begin
          Result := False;
          Break;
        end;
        Found := FindNext(FindRec);
      end;
    finally
      FindClose(FindRec);
    end;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  AppDir: string;
  CnfgDir: string;
  FilesToDelete: TArrayOfString;
  PatternsToDelete: TArrayOfString;
  I: Integer;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    CnfgDir := ExpandConstant('{#CnfgDir}');
    AppDir := ExpandConstant('{app}');
    FilesToDelete := GetCnfgFilesToDelete();
    PatternsToDelete := GetCnfgPatternsToDelete();

    for I := 0 to GetArrayLength(FilesToDelete) - 1 do
    begin
      if FileExists(FilesToDelete[I]) then
        DeleteFile(FilesToDelete[I]);
    end;

    for I := 0 to GetArrayLength(PatternsToDelete) - 1 do
      DeleteFilesByPattern(CnfgDir, PatternsToDelete[I]);

    if DirExists(CnfgDir) and IsDirEmpty(CnfgDir) then
      RemoveDir(CnfgDir);

    // {app} itself: the standard uninstall already removed filey.exe (the
    // only [Files] entry) and would have removed {app} too if that had
    // left it empty. Older versions of filey left numbered and hex-named
    // files there (see above), so clear those out and finish the job.
    DeleteUnderscoreDigitsFiles(AppDir);
    DeleteHexNameFiles(AppDir);

    if DirExists(AppDir) and IsDirEmpty(AppDir) then
      RemoveDir(AppDir);
  end;
end;
